# UptimeRobot API Key（只读）
VITE_UPTIMEROBOT_API_KEY = "your_uptimerobot_readonly_api_key"

# UptimeRobot API URL
# EdgeOne Pages / Vercel / Cloudflare Pages 使用 "/api/status"
# 其他部署方式设置为你的代理地址，例如 "https://api.uptimerobot.com/v2/getMonitors"
VITE_UPTIMEROBOT_API_URL = "/api/status"

# 站点名称
VITE_APP_TITLE = "我的状态监控"
